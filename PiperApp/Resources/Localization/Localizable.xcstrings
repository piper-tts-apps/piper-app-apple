    "model_format_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على التنزيلات الجديدة. تحتفظ الأصوات المثبتة بتنسيقها. الأصوات المضغوطة أصغر وتستخدم ذاكرة أقل، بجودة أقل قليلاً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ডাউনলোডের ক্ষেত্রে প্রযোজ্য। ইনস্টল করা ভয়েস তাদের ফরম্যাট রাখে। কমপ্যাক্ট ভয়েসগুলি ছোট এবং কম মেমরি ব্যবহার করে, কিছুটা কম মানের সাথে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für neue Downloads. Installierte Stimmen behalten ihr Format. Kompakte Stimmen sind kleiner und verbrauchen weniger Speicher, bei leicht reduzierter Qualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to new downloads. Installed voices keep their format. Compact voices are smaller and use less memory, with slightly reduced quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a las nuevas descargas. Las voces instaladas conservan su formato. Las voces compactas son más pequeños y usan menos memoria, con una calidad ligeramente reducida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique aux nouveaux téléchargements. Les voix installées conservent leur format. Les voix compactes sont plus petits et utilisent moins de mémoire, avec une qualité légèrement réduite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए डाउनलोड पर लागू होता है। इंस्टॉल की गई आवाज़ें अपना प्रारूप बनाए रखती हैं। कॉम्पैक्ट वॉइस छोटे होते हैं और थोड़ी कम गुणवत्ता के साथ कम मेमोरी का उपयोग करते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új letöltésekre vonatkozik. A telepített hangok megtartják formátumukat. A kompakt hangok kisebbek és kevesebb memóriát használnak, kissé csökkent minőséggel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk unduhan baru. Suara yang terpasang mempertahankan formatnya. Suara ringkas lebih kecil dan menggunakan lebih sedikit memori, dengan kualitas sedikit berkurang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica ai nuovi download. Le voci installate mantengono il loro formato. Le voci compatte sono più piccoli e usano meno memoria, con una qualità leggermente ridotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいダウンロードに適用されます。インストール済みの音声は形式を保持します。コンパクト音声は小さく、使用メモリも少なくなりますが、品質はわずかに低下します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor nieuwe downloads. Geïnstalleerde stemmen behouden hun formaat. Compacte stemmen zijn kleiner en gebruiken minder geheugen, met iets lagere kwaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy nowych pobrań. Zainstalowane głosy zachowują swój format. Głosy kompaktowe są mniejsze i zużywają mniej pamięci, przy nieco obniżonej jakości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a novos downloads. As vozes instaladas mantêm o seu formato. As vozes compactas são menores e usam menos memória, com qualidade ligeiramente reduzida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller för nya hämtningar. Installerade röster behåller sitt format. Kompakta röster är mindre och använder mindre minne, med något lägre kvalitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni indirmeler için geçerlidir. Yüklü sesler biçimlerini korur. Kompakt sesler daha küçüktür ve biraz daha düşük kaliteyle daha az bellek kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується до нових завантажень. Встановлені голоси зберігають свій формат. Компактні голоси менші та споживають менше пам'яті, з дещо нижчою якістю."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نئے ڈاؤن لوڈز پر لاگو ہوتا ہے۔ انسٹال شدہ آوازیں اپنا فارمیٹ برقرار رکھتی ہیں۔ کمپیکٹ آوازیں چھوٹی ہوتی ہیں اور قدرے کم معیار کے ساتھ کم میموری استعمال کرتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于新下载。已安装的语音保持其格式。紧凑语音更小，占用内存更少，质量略有降低。"
          }
        }
      }
    },
