    "app_help_line_5" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تثبيت أصوات مخصصة باستخدام **استيراد نموذج من الملفات** في **الإعدادات** عن طريق اختيار نموذج `.onnx` وتكوين `.json` الخاص به."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি `.onnx` মডেল এবং এর `.json` কনফিগারেশন নির্বাচন করে **সেটিংসে** **Import Model from Files** ব্যবহার করে কাস্টম ভয়েস ইনস্টল করা যেতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Stimmen können in den **Einstellungen** über **Modell aus Dateien importieren** installiert werden, indem ein `.onnx`-Modell und die zugehörige `.json`-Konfiguration ausgewählt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom voices can be installed in **Settings** using **Import Model from Files** by selecting a `.onnx` model and its `.json` configuration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pueden instalar voces personalizadas desde **Ajustes** usando **Importar modelo desde archivos** seleccionando un modelo `.onnx` y su configuración `.json`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des voix personnalisées peuvent être installées dans **Réglages** via **Importer le modèle depuis les fichiers** en sélectionnant un modèle `.onnx` et sa configuration `.json`."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम आवाज़ें **सेटिंग** में **फ़ाइलों से मॉडल आयात करें** का उपयोग करके एक `.onnx` मॉडल और उसके `.json` कॉन्फ़िगरेशन का चयन करके इंस्टॉल की जा सकती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyéni hangok telepíthetők a **Beállításokban** a **Modell importálása fájlokból** opcióval, egy `.onnx` modell és a hozzá tartozó `.json` konfiguráció kiválasztásával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara kustom dapat diinstal di **Pengaturan** menggunakan **Impor Model dari Berkas** dengan memilih model `.onnx` dan konfigurasi `.json`-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci personalizzate possono essere installate in **Impostazioni** utilizzando **Importa modello da file** selezionando un modello `.onnx` e la sua configurazione `.json`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム音声は、`.onnx` モデルとその `.json` 設定を選択して、**設定**の **ファイルからモデルをインポート** を使用してインストールできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangepaste stemmen kunnen worden geïnstalleerd in **Instellingen** met **Importeer model uit bestanden** door een `.onnx`-model en de bijbehorende `.json`-configuratie te selecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własne głosy można zainstalować w **Ustawieniach** za pomocą **Importuj model z plików**, wybierając model `.onnx` i jego konfigurację `.json`."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassade röster kan installeras i **Inställningar** via **Importera modell från filer** genom att välja en `.onnx`-modell och dess `.json`-konfiguration."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vozes personalizadas podem ser instaladas em **Ajustes** usando **Importar Modelo de Arquivos** selecionando um modelo `.onnx` e sua configuração `.json`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel sesler, bir `.onnx` modeli ve `.json` yapılandırmasını seçerek **Ayarlar** bölümündeki **Dosyalardan Model İçe Aktar** ile yüklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користувальницькі голоси можуть бути встановлені у **Налаштуваннях** за допомогою **Імпортувати з файлів**, обравши модель `.onnx` і її конфігурацію `.json`."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ترتیبات** میں **Import Model from Files** کا استعمال کرتے ہوئے ایک **.onnx** ماڈل اور اس کی **.json** کنفیگریشن کو منتخب کر کے کسٹم آوازیں انسٹال کی جا سکتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过选择`.onnx`模型及其`.json`配置，可以在**设置**中使用 **从文件中导入模型** 安装自定义语音。"
          }
        }
      }
    },
    "app_help_line_6" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتوفير المساحة، عيّن **تنسيق الصوت** على **مضغوط** في **الإعدادات**: ستكون تنزيلات الأصوات الجديدة أصغر وستستخدم ذاكرة أقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জায়গা বাঁচাতে, **সেটিংসে** **ভয়েস ফরম্যাট** **কমপ্যাক্ট** হিসেবে সেট করুন: নতুন ভয়েস ডাউনলোডগুলি ছোট হবে এবং কম মেমরি ব্যবহার করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Speicherplatz zu sparen, stelle das **Stimmformat** in den **Einstellungen** auf **Kompakt**: Neue Stimm-Downloads sind dann kleiner und verbrauchen weniger Speicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save space, set **Voice format** to **Compact** in **Settings**: new voice downloads will be smaller and use less memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ahorrar espacio, ajusta **Formato de voz** a **Compacto** en **Ajustes**: las nuevas descargas de voces serán más pequeñas y usarán menos memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour économiser de l'espace, réglez **Format de voix** sur **Compact** dans **Réglages** : les nouveaux téléchargements de voix seront plus petits et utiliseront moins de mémoire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जगह बचाने के लिए, **सेटिंग्स** में **वॉइस प्रारूप** को **कॉम्पैक्ट** पर सेट करें: नए वॉइस डाउनलोड छोटे होंगे और कम मेमोरी का उपयोग करेंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helytakarékosság érdekében állítsd a **Hangformátumot** **Kompakt** értékre a **Beállításokban**: az új hangletöltések kisebbek lesznek és kevesebb memóriát használnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menghemat ruang, atur **Format suara** ke **Ringkas** di **Pengaturan**: unduhan suara baru akan lebih kecil dan menggunakan lebih sedikit memori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per risparmiare spazio, imposta **Formato della voce** su **Compatto** in **Impostazioni**: i nuovi download delle voci saranno più piccoli e useranno meno memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量を節約するには、**設定**で**音声形式**を**コンパクト**に設定してください。新しい音声ダウンロードが小さくなり、使用メモリも少なくなります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om ruimte te besparen, stel je **Stemformaat** in op **Compact** in **Instellingen**: nieuwe stemdownloads zijn dan kleiner en gebruiken minder geheugen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zaoszczędzić miejsce, ustaw **Format głosu** na **Kompaktowy** w **Ustawieniach**: nowe głosy do pobrania będą mniejsze i zajmą mniej pamięci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para economizar espaço, defina **Formato de voz** como **Compacto** em **Ajustes**: os novos downloads de vozes serão menores e usarão menos memória."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att spara utrymme, ställ in **Röstformat** på **Kompakt** i **Inställningar**: nya rösthämtningar blir mindre och använder mindre minne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yer kazanmak için **Ayarlar** bölümünde **Ses biçimini** **Kompakt** olarak ayarlayın: yeni ses indirmeleri daha küçük olacak ve daha az bellek kullanacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб заощадити місце, встановіть **Формат голосу** на **Компактний** у **Налаштуваннях**: нові завантаження голосів будуть меншими та споживатимуть менше пам'яті."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جگہ بچانے کے لیے، **ترتیبات** میں **آواز فارمیٹ** کو **کمپیکٹ** پر سیٹ کریں: نئے صوتی ڈاؤن لوڈز چھوٹے ہوں گے اور کم میموری استعمال کریں گے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要节省空间，请在**设置**中将**语音格式**设为**紧凑**:新的语音下载将更小，占用内存更少。"
          }
        }
      }
    },
    "app_help_line_7" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم **البحث** في أعلى الشاشة الرئيسية للعثور على صوت بالاسم أو اللغة. اضغط على حلقة التقدم لإلغاء تنزيل جارٍ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নাম বা ভাষা দিয়ে ভয়েস খুঁজতে প্রধান স্ক্রিনের উপরে **ভয়েস খুঁজুন** ব্যবহার করুন। চলমান ডাউনলোড বাতিল করতে প্রগ্রেস রিংয়ে ট্যাপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze **Stimmen suchen** oben auf dem Hauptbildschirm, um eine Stimme nach Name oder Sprache zu finden. Tippe auf den Fortschrittsring, um einen laufenden Download abzubrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use **Search** at the top of the main screen to find a voice by name or language. Tap the progress ring to cancel a download in progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa **Buscar voces** en la parte superior de la pantalla principal para encontrar una voz por nombre o idioma. Toca el anillo de progreso para cancelar una descarga en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez **Rechercher des voix** en haut de l'écran principal pour trouver une voix par nom ou par langue. Touchez l'anneau de progression pour annuler un téléchargement en cours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम या भाषा से आवाज़ खोजने के लिए मुख्य स्क्रीन के शीर्ष पर **वॉइस खोजें** का उपयोग करें। चल रहे डाउनलोड को रद्द करने के लिए प्रगति रिंग पर टैप करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használja a főképernyő tetején lévő **Hangok keresése** funkciót, ha név vagy nyelv alapján keres hangot. A folyamatjelző gyűrűre koppintva megszakíthat egy folyamatban lévő letöltést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan **Cari suara** di bagian atas layar utama untuk menemukan suara berdasarkan nama atau bahasa. Ketuk cincin kemajuan untuk membatalkan unduhan yang sedang berlangsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa **Cerca voci** nella parte superiore della schermata principale per trovare una voce per nome o lingua. Tocca l'anello di avanzamento per annullare un download in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前や言語で音声を探すには、メイン画面上部の **音声を検索** を使用してください。進行中のダウンロードをキャンセルするには、進行状況リングをタップしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik **Stemmen zoeken** bovenaan het hoofdscherm om een stem op naam of taal te vinden. Tik op de voortgangsring om een lopende download te annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj **Szukaj głosów** u góry ekranu głównego, aby znaleźć głos po nazwie lub języku. Stuknij pierścień postępu, aby anulować trwające pobieranie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use **Pesquisar vozes** na parte superior da tela principal para encontrar uma voz por nome ou idioma. Toque no anel de progresso para cancelar um download em andamento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd **Sök röster** högst upp på huvudskärmen för att hitta en röst efter namn eller språk. Tryck på förloppsringen för att avbryta en pågående hämtning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada veya dile göre ses bulmak için ana ekranın üst kısmındaki **Sesleri ara** özelliğini kullanın. Devam eden bir indirmeyi iptal etmek için ilerleme halkasına dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте **Пошук голосів** у верхній частині головного екрана, щоб знайти голос за назвою або мовою. Торкніться кільця прогресу, щоб скасувати поточне завантаження."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام یا زبان کے ذریعے آواز تلاش کرنے کے لیے مرکزی اسکرین کے اوپر **آوازیں تلاش کریں** استعمال کریں۔ جاری ڈاؤن لوڈ منسوخ کرنے کے لیے پروگریس رنگ پر ٹیپ کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用主屏幕顶部的 **搜索语音** 按名称或语言查找语音。点击进度环可取消正在进行的下载。"
          }
        }
      }
    },
