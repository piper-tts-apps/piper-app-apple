    "no_voices_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**لم يتم تثبيت أي أصوات بعد.**\nاختر لغة أدناه لإضافة صوت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**এখনো কোনো ভয়েস ইনস্টল করা হয়নি।**\nএকটি ভয়েস যোগ করতে নিচে একটি ভাষা বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Es sind noch keine Stimmen installiert.**\nWähle unten eine Sprache, um eine Stimme hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**No voices are installed yet.**\nChoose a language below to add a voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Aún no hay voces instaladas.**\nElige un idioma abajo para añadir una voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Aucune voix n'est installée.**\nChoisissez une langue ci-dessous pour ajouter une voix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**अभी तक कोई आवाज़ इंस्टॉल नहीं की गई है।**\nआवाज़ जोड़ने के लिए नीचे एक भाषा चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Még nincsenek hangok telepítve.**\nHang hozzáadásához válasszon egy nyelvet alább."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Belum ada suara yang diinstal.**\nPilih bahasa di bawah ini untuk menambahkan suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Nessuna voce ancora installata.**\nScegli una lingua qui sotto per aggiungere una voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**音声がまだインストールされていません。**\n下で言語を選択して音声を追加してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Er zijn nog geen stemmen geïnstalleerd.**\nKies hieronder een taal om een stem toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Żadne głosy nie są jeszcze zainstalowane.**\nWybierz język poniżej, aby dodać głos."
          }
        },
        "sv" : {
